[Unit]
Description=Stonepi AP - hostapd + dnsmasq
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStartPre=/opt/stonepi/detect-iface.sh ap
ExecStartPre=+/bin/bash -c 'nmcli device set $(/opt/stonepi/detect-iface.sh ap) managed no'
ExecStart=/opt/stonepi/start-ap.sh
ExecStartPost=/opt/stonepi/cleanup-warp.sh
ExecStop=/bin/sh -c 'killall hostapd 2>/dev/null; killall dnsmasq 2>/dev/null'
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
