[Unit]
Description=escama AP - hostapd + dnsmasq (Python core)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/opt/escama/escama.py start
ExecStop=/opt/escama/escama.py stop
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
