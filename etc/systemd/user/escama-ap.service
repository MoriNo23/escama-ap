[Unit]
Description=escama AP (modo usuario) - hostapd + dnsmasq sin sudo
Documentation=file:/opt/escama/README.md
# Unit de USUARIO: se habilita con `install.sh enable --user` y arranca al
# iniciar sesion, sin privileged unit de sistema (spec `uso-sin-privilegios`).
#
# Por que el launcher: el kernel ignora las file capabilities en scripts con
# shebang, asi que /opt/escama/escama-launch es un binario ELF con
# CAP_NET_ADMIN/RAW/BIND_SERVICE que se las pasa al Python via el set ambient.
# Invocar el Python directo NO tendria las capabilities.
#
# network-online.target NO se usa: es un target de sistema y una unit de
# usuario no puede ordenarse contra el. El AP no necesita internet para
# arrancar: levanta su propia red y el egress se resuelve despues.

[Service]
# Type=forking, NO oneshot+RemainAfterExit: hostapd arranca con -B y dnsmasq
# daemoniza, asi que el proceso de `start` termina enseguida. Con oneshot,
# systemd daba la unit por cumplida para siempre y reportaba `active` aunque
# hostapd y dnsmasq estuvieran muertos (medido), y con Restart=on-failure no
# los resucitaba. Con forking+PIDFile systemd sigue al proceso real: si muere,
# `is-active` lo dice y Restart lo levanta.
Type=forking
# %t = XDG_RUNTIME_DIR. Es el mismo pidfile que escribe dnsmasq en modo
# rootless (ver _lease_path/pidfile en escama.py): no se inventa una ruta.
PIDFile=%t/dnsmasq-escama.pid
ExecStart=/opt/escama/escama-launch core start
ExecStop=/opt/escama/escama-launch core stop
Restart=on-failure
RestartSec=10
# El watcher de egress corre como user service aparte (escama-egress.service).
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
