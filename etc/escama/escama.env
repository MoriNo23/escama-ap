# escama.env — central configuration for escama-ap (hostapd + dnsmasq AP converter)
#
# This file is read by all escama scripts and generated/edited by config-tui.sh.
# Values below are the DEFAULTS; override them via the TUI or by editing this file.
# After editing, restart the service: sudo systemctl restart escama-ap.service

# --- Access Point interface (the designated AP / "escama") ---
# Default: wn8200nd (TL-WN8200ND adapter).
# The WAN/internet WiFi interface is a SEPARATE device and keeps the name "stonepi".
AP_IFACE="wn8200nd"

# --- AP network ---
AP_IP="10.42.1.1"
AP_CIDR="24"
AP_SUBNET="10.42.1.0/24"
DHCP_START="10.42.1.10"
DHCP_END="10.42.1.254"
DHCP_LEASE="12h"

# --- hostapd / SSID ---
SSID="escama"
CHANNEL="6"
HW_MODE="g"
WPA_PASSPHRASE="#GoticasCulonas@@"

# --- DNS for DHCP clients ---
DNS1="8.8.8.8"
DNS2="8.8.4.4"

# --- VPN egress (ProtonVPN / warp-cli / WireGuard / OpenVPN) ---
# Por donde salen los CLIENTES del AP:
#   auto : si hay un tunnel VPN arriba usan el tunnel; si no, WAN_IFACE (fallback)
#   vpn  : exigen tunnel. Sin tunnel NO hay internet (kill-switch, fail-closed)
#   wan  : ignoran el tunnel, siempre NAT por WAN_IFACE (comportamiento clasico)
EGRESS_MODE="auto"

# Nombre del tunnel. Vacio = auto-deteccion (proton0, pvpn0, CloudflareWARP,
# wg0, tun0, nordlynx, ...). Ponelo explicito si tenes varios tunnels arriba.
VPN_IFACE=""

# Forzar policy routing (tabla 51821) para que el trafico del AP entre al
# tunnel aunque la ruta default del host no sea el tunnel.
# IMPRESCINDIBLE con warp-cli (usa split tunnel + fwmark) y con wg-quick.
VPN_FORCE_ROUTE="yes"

# Clamp de MSS a la MTU del tunnel. Evita el clasico "carga Google pero no
# carga ninguna web pesada" por PMTU roto detras de WireGuard (MTU 1280-1420).
VPN_MSS_CLAMP="yes"

# DNS entregado a los clientes cuando salen por VPN. Vacio = usar DNS1/DNS2.
# Recomendado para no filtrar DNS fuera del tunnel:
#   ProtonVPN -> 10.2.0.1     |  WARP -> 1.1.1.1 / 1.0.0.1
VPN_DNS1=""
VPN_DNS2=""

# --- WAN interface override (optional) ---
# Leave empty to auto-detect from the default route.
# The WAN WiFi interface keeps the name "stonepi".
WAN_IFACE=""
